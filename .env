SKIP_PREFLIGHT_CHECK=true
VITE_VALHALLA_URL=http://localhost:3000/valhalla
VALHALLA_PROXY_TARGET=http://localhost:8002
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
VITE_TILE_SERVER_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_CENTER_COORDS="52.51831,13.393707"

# Possible values: auto, bicycle, pedestrian, car, truck, bus, motor_scooter, motorcycle, emergency
VITE_DEFAULT_COSTING_MODEL=emergency

# Identifier sent as the X-Client-Id header on Valhalla requests.
VITE_CLIENT_ID=unknown-web-app
